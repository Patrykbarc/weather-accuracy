# Environment for the systemd units, kept on the server at
# /etc/weather-accuracy.env with mode 640 and owner root:weather.
#
# The ping URL is a credential. Anyone holding it can report a
# successful run that never happened.
#
#   cp deploy/weather-accuracy.env.example /etc/weather-accuracy.env
#   chmod 640 /etc/weather-accuracy.env
#   chown root:weather /etc/weather-accuracy.env

# Pinged after every successful collector run. If the ping stops arriving,
# healthchecks.io emails me. Set the check to a one day period with a few
# hours of grace, so an outage shows up the same morning.
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
